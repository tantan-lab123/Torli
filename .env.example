# ==============================================================================
# Supabase Configuration
# (If not provided, the app automatically falls back to the in-memory mock engine)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Background Cron Worker Security Token
# ==============================================================================
CRON_SECRET=schedule-cron-secret-key-123

# Public App URL for links generated in notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000
